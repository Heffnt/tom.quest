# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# python
__pycache__/

# claude code worktrees
.claude/worktrees/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
turing-api/*.log

# env files (can opt-in for committing if needed)
.env*
# ...and we do opt in for exactly one: .env holds the NEXT_PUBLIC_* Convex
# deployment identity, which Next.js inlines into the browser bundle and is
# therefore public by construction. Committing it is what makes a bare checkout
# buildable without Vercel credentials. Secrets stay in secrets/ (below).
!.env

# Tom-only secrets directory; only .example templates are committed.
/secrets/*
!/secrets/.gitkeep
!/secrets/*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Sentry Config File
.env.sentry-build-plugin
test-results/

# A scaffolded negative is a DRAFT until Tom confirms it by renaming the file.
# A committed draft would enter the golden set unconfirmed, which is the one
# thing the evals layer exists to prevent.
evals/triggers/*.draft.json

# Privacy rule: nothing from model-of-tom enters this public repository; area
# trigger cases live in WikiTom evals/triggers/.
evals/triggers/skill-know-*.json
!evals/triggers/skill-know-intent.json
!evals/triggers/skill-know-week.json

# Fixture worktrees the evals suite builds. They live INSIDE the project root
# because the code under test imports out of them and vitest resolves a
# dynamic import through Vite, which serves nothing outside the root
# (worker/jobs/evals.test.mjs tree()). afterEach removes them; this line is
# for the run that was killed before it could.
.evals-tree-*/
