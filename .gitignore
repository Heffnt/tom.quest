# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# python
__pycache__/

# claude code worktrees
.claude/worktrees/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
turing-api/*.log

# env files (can opt-in for committing if needed)
.env*
# ...and we do opt in for exactly one: .env holds the NEXT_PUBLIC_* Convex
# deployment identity, which Next.js inlines into the browser bundle and is
# therefore public by construction. Committing it is what makes a bare checkout
# buildable without Vercel credentials. Secrets stay in secrets/ (below).
!.env

# Tom-only secrets directory; only .example templates are committed.
/secrets/*
!/secrets/.gitkeep
!/secrets/*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Sentry Config File
.env.sentry-build-plugin
test-results/
