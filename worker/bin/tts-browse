#!/usr/bin/env node
// tts-browse — open a real headless Chromium at a URL, report what the page
// did, and leave a screenshot behind.
//
// WHY THIS EXISTS: a TTS session can change a tom.quest page but, until now,
// could not look at the result — it had to end by asking Tom to tap through
// the change himself. This is the "look at it" tool. It is deliberately one
// command with a flat set of flags rather than a library, because the caller
// is a model in a shell, not another program.
//
// WHAT IT REPORTS, and why each line is worth printing:
//   status  — the HTTP status of the top-level navigation.
//   title   — cheap confirmation the right page rendered and not an error shell.
//   console — console errors only. Silent breakage in a React tree shows up
//             here and nowhere else.
//   failed  — requests that errored or answered 4xx/5xx. A whole class of
//             tom.quest bug is "a request that should never have been sent"
//             (an id still resolving, a placeholder segment); this is the line
//             that makes such a request visible instead of inferred.
//   shot    — path to the PNG, for reading with the Read tool.
//
// USAGE
//   tts-browse <url> [--out FILE] [--login] [--wait SEL] [--click SEL]...
//              [--type SEL=TEXT]... [--viewport WxH] [--full] [--settle MS]
//              [--json]
//
//   --login    sign in first, using TOMQUEST_AGENT_USERNAME /
//              TOMQUEST_AGENT_PASSWORD from the environment (systemd passes
//              /etc/tts/worker.env into the session-host, which passes them
//              on). Without those two keys the flag fails loudly rather than
//              silently browsing as an anonymous visitor and reporting an
//              empty page — every /turing and /tts page is role-gated, so an
//              anonymous read of one is a false negative, not a result.
//   --settle   extra idle wait after load, default 1500ms. Convex-backed pages
//              paint twice: once from cache, once from the live query.
//
// ZERO-DEPS NOTE: the worker box's job scripts take no npm dependencies, but
// Playwright is installed GLOBALLY by worker/setup.sh (step 4) precisely so
// this file can load it without a per-session install. Browser loading and the
// tom.quest sign-in both live in tts-auth-lib.mjs, shared with tts-turing, so
// the login sequence is written once.

import { loadPlaywright, signIn } from "/usr/local/bin/tts-auth-lib.mjs";

function parseArgs(argv) {
  const opts = {
    url: null,
    out: "/tmp/tts-browse.png",
    login: false,
    wait: null,
    clicks: [],
    types: [],
    viewport: { width: 390, height: 844 },
    full: false,
    settle: 1500,
    json: false,
  };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    const next = () => {
      const v = argv[++i];
      if (v === undefined) {
        console.error(`tts-browse: ${a} needs a value`);
        process.exit(2);
      }
      return v;
    };
    if (a === "--out") opts.out = next();
    else if (a === "--login") opts.login = true;
    else if (a === "--wait") opts.wait = next();
    else if (a === "--click") opts.clicks.push(next());
    else if (a === "--type") opts.types.push(next());
    else if (a === "--full") opts.full = true;
    else if (a === "--json") opts.json = true;
    else if (a === "--settle") opts.settle = Number(next());
    else if (a === "--viewport") {
      const [w, h] = next().split("x").map(Number);
      if (!w || !h) {
        console.error("tts-browse: --viewport wants WxH, e.g. 390x844");
        process.exit(2);
      }
      opts.viewport = { width: w, height: h };
    } else if (a === "--help" || a === "-h") {
      console.log(
        "tts-browse <url> [--out FILE] [--login] [--wait SEL] [--click SEL]... " +
          "[--type SEL=TEXT]... [--viewport WxH] [--full] [--settle MS] [--json]",
      );
      process.exit(0);
    } else if (a.startsWith("-")) {
      console.error(`tts-browse: unknown flag ${a}`);
      process.exit(2);
    } else if (opts.url === null) opts.url = a;
    else {
      console.error(`tts-browse: unexpected argument ${a}`);
      process.exit(2);
    }
  }
  if (!opts.url) {
    console.error("tts-browse: a url is required");
    process.exit(2);
  }
  if (!/^https?:\/\//.test(opts.url)) opts.url = "https://" + opts.url;
  return opts;
}

async function main() {
  const opts = parseArgs(process.argv.slice(2));
  const { chromium } = loadPlaywright();
  const consoleErrors = [];
  const failed = [];

  const browser = await chromium.launch();
  const context = await browser.newContext({ viewport: opts.viewport });
  const page = await context.newPage();

  page.on("console", (msg) => {
    if (msg.type() === "error") consoleErrors.push(msg.text().slice(0, 300));
  });
  // A failure that a later identical request succeeds at is a retry, not a
  // defect — an admin page that fires before its auth token resolves takes a
  // 401 and recovers. Reporting that the same way as a real failure trains the
  // reader to ignore the line, so successes are tracked and used to annotate.
  const succeeded = new Set();
  page.on("requestfailed", (req) =>
    failed.push({
      url: req.url(),
      text: `${req.method()} ${req.url()} — ${req.failure()?.errorText ?? "failed"}`,
    }),
  );
  page.on("response", (res) => {
    const url = res.url();
    if (res.status() >= 400) {
      failed.push({ url, text: `${res.status()} ${res.request().method()} ${url}` });
    } else if (res.status() < 300) {
      succeeded.add(url);
    }
  });

  let signedInAs = null;
  try {
    if (opts.login) {
      // Probe navigation, only to learn where the URL actually lands after any
      // redirect. Sign in on THAT origin (see signIn's note), then throw away
      // everything the probe recorded — its 401s are expected and reporting
      // them would bury the ones that matter.
      await page.goto(opts.url, { waitUntil: "domcontentloaded", timeout: 45000 });
      signedInAs = await signIn(page, new URL(page.url()).origin);
      consoleErrors.length = 0;
      failed.length = 0;
    }

    const res = await page.goto(opts.url, { waitUntil: "domcontentloaded", timeout: 45000 });
    if (opts.wait) await page.waitForSelector(opts.wait, { timeout: 30000 });
    for (const sel of opts.clicks) await page.click(sel, { timeout: 15000 });
    for (const t of opts.types) {
      const eq = t.indexOf("=");
      await page.fill(t.slice(0, eq), t.slice(eq + 1), { timeout: 15000 });
    }
    if (opts.settle > 0) await page.waitForTimeout(opts.settle);
    await page.screenshot({ path: opts.out, fullPage: opts.full });

    const failedRequests = failed.map((f) =>
      succeeded.has(f.url) ? `${f.text}  (a later identical request succeeded)` : f.text,
    );
    const result = {
      url: page.url(),
      status: res?.status() ?? null,
      title: await page.title(),
      signedInAs,
      consoleErrors,
      failedRequests,
      screenshot: opts.out,
    };
    if (opts.json) {
      console.log(JSON.stringify(result, null, 2));
    } else {
      console.log(`url:     ${result.url}`);
      console.log(`status:  ${result.status}`);
      console.log(`title:   ${result.title}`);
      if (signedInAs) console.log(`signed:  ${signedInAs}`);
      console.log(`console: ${consoleErrors.length ? "" : "(no errors)"}`);
      for (const e of consoleErrors) console.log(`  ! ${e}`);
      console.log(`failed:  ${failedRequests.length ? "" : "(none)"}`);
      for (const f of failedRequests) console.log(`  ! ${f}`);
      console.log(`shot:    ${result.screenshot}`);
    }
  } finally {
    await browser.close();
  }
}

main().catch((err) => {
  console.error(`tts-browse: ${err?.message ?? err}`);
  process.exit(1);
});
