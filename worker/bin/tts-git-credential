#!/bin/sh
# tts-git-credential — git credential helper for the Jarvis Box.
#
# Installed by worker/setup.sh as git's GLOBAL credential.helper so that
# every git process on the box (the session-host daemon's clones, and the
# `git push` a session runs in its own shell) authenticates to github.com
# WITHOUT the token ever appearing in a remote URL, a work tree, or a
# model-reachable environment variable. The token's one home stays
# /etc/tts/worker.env (root-only, mode 600); this helper reads it at the
# moment git asks and prints it on git's credential protocol.
#
# Ledger graduation sessions-cannot-open-prs (2026-08-31): before this, the
# token rode in each clone's remote URL, so any session could read the
# account-wide repo-write token out of .git/config — the env scrub raised
# the cost of reaching it without removing it.
#
# Protocol: git invokes `<helper> get|store|erase` with key=value lines on
# stdin. Only `get` for github.com is answered; store/erase are no-ops (the
# env file is the store, and git must never rewrite it).

[ "$1" = "get" ] || exit 0

host=""
while IFS= read -r line && [ -n "$line" ]; do
  case "$line" in
    host=*) host="${line#host=}" ;;
  esac
done

[ "$host" = "github.com" ] || exit 0

token="$(sed -n 's/^GH_TOKEN=//p' /etc/tts/worker.env 2>/dev/null | tail -1)"
[ -n "$token" ] || exit 0

printf 'username=x-access-token\npassword=%s\n' "$token"
