#!/usr/bin/env bash
# tts-account — switch which Claude Max account the TTS worker jobs run under.
#
# Two accounts live in separate Claude Code config dirs:
#   /root/.claude-accounts/gmail
#   /root/.claude-accounts/wpi
# and /root/.claude-accounts/active is a symlink to one of them. Every
# scheduled job runs with CLAUDE_CONFIG_DIR=/root/.claude-accounts/active,
# so switching accounts is just repointing the symlink — no job changes.
#
# Usage:
#   tts-account use gmail|wpi     repoint the active symlink
#   tts-account status            show which account is active, and which
#                                 email each slot actually holds
#   tts-account login             interactive `claude /login`; the credentials
#                                 are FILED into the slot matching the account
#                                 that actually signed in (@wpi.edu -> wpi,
#                                 @gmail.com -> gmail). Run OVER SSH,
#                                 interactively — it opens a browser-auth
#                                 flow; not for cron. An optional gmail|wpi
#                                 argument is only a stated expectation: the
#                                 command says so if a different account
#                                 landed, but files it correctly either way.
#                                 (Merged 2026-09-01: `login wpi` and `login
#                                 gmail` ran the identical browser flow, and
#                                 which account landed was decided by the
#                                 browser's signed-in session, not the
#                                 argument — so the argument silently filed
#                                 the wrong account into the named slot.)
set -euo pipefail

BASE=/root/.claude-accounts

usage() {
  echo "usage: tts-account use gmail|wpi | tts-account status | tts-account login [gmail|wpi]" >&2
  exit 1
}

check_acct() {
  case "${1:-}" in
    gmail|wpi) ;;
    *) usage ;;
  esac
}

# Which email a config dir is actually logged in as ("" if none). The slot
# NAME is an intention; the OAuth page decides the fact — on 2026-08-31
# `login wpi` quietly landed the already-signed-in gmail account in the wpi
# slot, so both slots held one account and the usage-limit auto-switch
# switched to itself. That is why login now files by this fact.
dir_email() {
  python3 - "$1/.claude.json" 2>/dev/null <<'PY'
import json, sys
try:
    print((json.load(open(sys.argv[1])).get("oauthAccount") or {}).get("emailAddress") or "")
except Exception:
    print("")
PY
}

slot_email() {
  dir_email "$BASE/$1"
}

# Which slot an email belongs in ("" if it matches no known account).
email_slot() {
  case "$1" in
    *@wpi.edu) echo wpi ;;
    heffnt@gmail.com|*@gmail.com) echo gmail ;;
    *) echo "" ;;
  esac
}

case "${1:-}" in
  use)
    check_acct "${2:-}"
    mkdir -p "$BASE/$2"
    ln -sfn "$BASE/$2" "$BASE/active"   # -n: replace the symlink itself, atomically enough for us
    echo "active account -> $2"
    ;;
  status)
    if [ -L "$BASE/active" ]; then
      echo "active account -> $(basename "$(readlink "$BASE/active")")"
    else
      echo "no active account set — run: tts-account use gmail|wpi"
    fi
    # The fact per slot, not the intention: which email actually sits there.
    for slot in gmail wpi; do
      echo "  $slot slot: $(slot_email "$slot" | sed 's/^$/NOT LOGGED IN/')"
    done
    if [ -n "$(slot_email gmail)" ] && [ "$(slot_email gmail)" = "$(slot_email wpi)" ]; then
      echo "  WARNING: both slots hold the SAME account — the usage-limit"
      echo "  auto-switch is a no-op. Re-run: tts-account login <the other one>"
      echo "  and pick the OTHER account on the browser's account chooser."
    fi
    ;;
  login)
    # One flow, filed by outcome. An argument is only an expectation.
    expect="${2:-}"
    if [ -n "$expect" ]; then check_acct "$expect"; fi
    echo "Logging in (interactive — follow the prompts)."
    echo "NOTE: the browser signs in whatever account ITS profile holds —"
    echo "switch the browser profile first if you want the other account."
    tmp="$(mktemp -d "$BASE/login.XXXXXX")"
    CLAUDE_CONFIG_DIR="$tmp" claude /login || { rm -rf "$tmp"; exit 1; }
    got="$(dir_email "$tmp")"
    if [ -z "$got" ]; then
      rm -rf "$tmp"
      echo "no account landed (login aborted?) — nothing changed" >&2
      exit 1
    fi
    slot="$(email_slot "$got")"
    if [ -z "$slot" ]; then
      rm -rf "$tmp"
      echo "signed in as '$got', which matches no known slot (wpi = *@wpi.edu," >&2
      echo "gmail = *@gmail.com) — discarded; nothing changed" >&2
      exit 1
    fi
    rm -rf "$BASE/$slot"
    mv "$tmp" "$BASE/$slot"
    echo "filed into the '$slot' slot: $got"
    if [ -n "$expect" ] && [ "$expect" != "$slot" ]; then
      echo "NOTE: you asked to log in '$expect' but the browser signed in the"
      echo "$slot account — filed where it belongs. To fill the '$expect'"
      echo "slot, switch the browser profile and run: tts-account login"
    fi
    ;;
  *)
    usage
    ;;
esac
