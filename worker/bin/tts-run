#!/bin/sh
# tts-run — run one agent on the Jarvis Box from anywhere, including over ssh.
#
# WHY THIS EXISTS: the laptop's transport (scripts/box-agent.mjs) sends one ssh
# line and nothing else. That line has to name a command on the box's PATH,
# because the laptop knows no path inside /opt/tts and must not learn one.
#
# It is a two-line forwarder ON PURPOSE, exactly like tts-codex beside it.
# setup.sh copies worker/runs/*.mjs to /opt/tts/runs/, and everything that
# matters — the flags, the semaphore, the worktree, the registration envelope,
# the redaction, the clean-stdout contract — lives in that one file, so the two
# ways of reaching a box run can never drift apart.
#
#   tts-run [flags] < prompt.txt
#
# Flags: --cli claude|codex, --repo NAME,
# --ref REF, --cwd DIR, --model NAME, --effort LEVEL, --sandbox MODE,
# --schema FILE, --allowed-tools A,B, --disallowed-tools A,B,
# --permission-mode MODE, --max-turns N, --output-format text|json, --tests,
# --install, --parent RUNID, --root RUNID, --depth N, --keep-worktree,
# --timeout MS. The prompt arrives on stdin; only the run's report and one
# status line come back on stdout. The cron jobs reach the same body in
# process, through runClaude in worker/jobs/tts-lib.mjs.
exec node /opt/tts/runs/box-run.mjs "$@"
