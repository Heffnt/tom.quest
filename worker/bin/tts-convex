#!/usr/bin/env node
// tts-convex — run the Convex command line against the production deployment
// from the Jarvis Box.
//
// WHY THIS EXISTS: Tom's ruling of 2026-09-24, "lets make it so that you can
// run those commands yourself". A one-run migration such as
// `npx convex run ttsMigrations:internalConvertClosedUpstreamGoals` could only
// be run from his laptop, because the box held no Convex deploy key. He pastes
// a production deploy key on tom.quest/secrets under CONVEX_DEPLOY_KEY, the
// session-host daemon writes it into /etc/tts/worker.env, and this command
// hands it to one `convex` process.
//
//   tts-convex run <function> [<json args>] [convex run flags]
//   tts-convex <any convex subcommand> [its args]
//
// THE KEY IS READ HERE, NOT INHERITED, the way scripts/codex-run.mjs reads
// OPENROUTER_API_KEY. env-scrub.mjs removes CONVEX_DEPLOY_KEY from every spawn
// a model can reach, so no session shell holds it; this command reads it from
// the env file (RUN_ENV_FILE, else /etc/tts/worker.env) and puts it into the
// environment of the child `convex` process alone. It is never an argument,
// never printed, and never written to this process's own environment, so
// nothing else this command starts could inherit it.
//
// THE CHECKOUT IS /root/tom.quest (TOM_QUEST_DIR overrides it, as it does for
// the nightly job). It is the rollout's working copy: a rollout is
// `git pull --ff-only origin main` there followed by `bash worker/setup.sh`,
// so after each rollout it is at main, and main is what the push deployed.
// The function names this command is asked for are the names in that code.
// The `convex` program is that checkout's own node_modules/.bin/convex, the
// same file `npx convex` would pick there; calling it by path means a checkout
// without its packages is refused rather than downloaded into.
//
// EVERY RUN IS RECORDED in /var/log/tts/convex.log (TTS_CONVEX_LOG overrides
// it), one JSON line: the time, the subcommand, the function name, the exit
// code, and for `run` the rest of its arguments. Those are logged because they
// are the function's inputs, the thing a later reader needs to know what a
// migration was told to do. Any other subcommand's arguments are not logged,
// because `env set NAME value` carries a secret as an argument. The key's
// value is cut out of the line in case an argument ever quotes it.
//
// Exit codes: the child's own exit code when it ran · 2 usage, or a checkout
// with no convex program · 3 no CONVEX_DEPLOY_KEY in the env file (nothing
// ran) · 128 + the signal number when the child was killed by a signal.
import { spawn } from "node:child_process";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { fileURLToPath } from "node:url";

const KEY = "CONVEX_DEPLOY_KEY";
const CHECKOUT = process.env.TOM_QUEST_DIR || "/root/tom.quest";
const LOG = process.env.TTS_CONVEX_LOG || "/var/log/tts/convex.log";

// The one reader of the env file, from the repo when run from a checkout and
// from the installed copy (setup.sh copies worker/jobs/*.mjs to /opt/tts/)
// otherwise.
async function workerEnv() {
  const jobsDir = process.env.TTS_JOBS_DIR ?? "/opt/tts";
  const candidates = [
    new URL("../jobs/worker-env.mjs", import.meta.url),
    new URL(`file://${path.join(jobsDir, "worker-env.mjs")}`),
  ];
  const found = candidates.find((candidate) => fs.existsSync(fileURLToPath(candidate)));
  if (!found) throw new Exit(2, "worker-env.mjs is not installed; run worker/setup.sh");
  return import(found.href);
}

class Exit extends Error {
  constructor(code, message) {
    super(message);
    this.code = code;
  }
}

function usage() {
  process.stderr.write(
    "usage: tts-convex run <function> [<json args>] [convex run flags]\n" +
      "       tts-convex <any convex subcommand> [its args]\n" +
      "\n" +
      `Runs the Convex command line in ${CHECKOUT} against the deployment that\n` +
      `${KEY} in the box's env file names (the production deployment), and\n` +
      `records the run in ${LOG}.\n` +
      "example: tts-convex run ttsMigrations:internalConvertClosedUpstreamGoals '{\"dryRun\":true}'\n",
  );
}

async function readKey() {
  const env = await workerEnv();
  const file = process.env.RUN_ENV_FILE || env.ENV_PATH;
  let value = "";
  try {
    value = env.loadEnv({ path: file })[KEY] ?? "";
  } catch {
    // An unreadable or absent file is the same refusal as an absent line.
  }
  if (!value) {
    throw new Exit(
      3,
      `${KEY} is not set in ${file}, so nothing ran. Tom makes a production deploy key ` +
        `in the Convex dashboard and pastes it on tom.quest/secrets under the name ${KEY}; ` +
        "the session-host daemon writes it into that file within 30 seconds.",
    );
  }
  return value;
}

// The line for convex.log. `key` is cut out of it wherever it appears.
function logLine(argv, exit, key) {
  const [subcommand = "", ...rest] = argv;
  const entry = { at: new Date().toISOString(), subcommand, function: null, exit };
  if (subcommand === "run") {
    entry.function = rest[0] ?? null;
    entry.args = rest.slice(1);
  }
  const text = JSON.stringify(entry);
  return (key ? text.split(key).join(`[${KEY}]`) : text) + "\n";
}

function record(argv, exit, key) {
  try {
    fs.mkdirSync(path.dirname(LOG), { recursive: true });
    fs.appendFileSync(LOG, logLine(argv, exit, key), { mode: 0o600 });
  } catch (error) {
    process.stderr.write(`tts-convex: the run was not recorded in ${LOG}: ${error.code ?? error.message}\n`);
  }
}

function runChild(program, argv, key) {
  // A copy: the key is in the child's environment and nowhere in this one.
  const env = { ...process.env, [KEY]: key };
  return new Promise((resolve) => {
    const child = spawn(program, argv, { cwd: CHECKOUT, env, stdio: "inherit" });
    child.on("error", (error) => {
      process.stderr.write(`tts-convex: could not start ${program}: ${error.code ?? error.message}\n`);
      resolve(2);
    });
    child.on("close", (code, signal) => {
      resolve(code ?? 128 + (os.constants.signals[signal] ?? 0));
    });
  });
}

const argv = process.argv.slice(2);
if (argv.length === 0 || argv[0] === "--help" || argv[0] === "-h") {
  usage();
  process.exit(argv.length === 0 ? 2 : 0);
}

let key = null;
let exit;
try {
  if (argv[0] === "run" && !argv[1]) throw new Exit(2, "run needs a function name, for example ttsMigrations:internalConvertClosedUpstreamGoals");
  key = await readKey();
  const program = path.join(CHECKOUT, "node_modules", ".bin", "convex");
  if (!fs.existsSync(program)) {
    throw new Exit(2, `${program} does not exist; run \`pnpm install\` in ${CHECKOUT}`);
  }
  exit = await runChild(program, argv, key);
} catch (error) {
  if (!(error instanceof Exit)) throw error;
  process.stderr.write(`tts-convex: ${error.message}\n`);
  exit = error.code;
}
record(argv, exit, key);
process.exit(exit);
