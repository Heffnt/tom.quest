# TTS worker box environment — template for /etc/tts/worker.env
#
# setup.sh copies this file to /etc/tts/worker.env (mode 600) if it does not
# exist yet. Fill in the real values there, NOT here — this template is
# committed to a public repo and must never contain secrets.
#
# Format: KEY=VALUE, one per line. Lines starting with '#' and blank lines are
# ignored. No quoting needed unless the value contains spaces (it shouldn't).

# The Convex *site* origin of the tom.quest deployment. This is the SAME
# subdomain as NEXT_PUBLIC_CONVEX_URL in the web app, but with the .site TLD
# instead of .cloud — HTTP actions (the /tts/* endpoints) are served from
# .convex.site, while the client API is served from .convex.cloud.
# Example: https://exuberant-walrus-123.convex.site
CONVEX_SITE_URL=

# Shared secret for the /tts/* HTTP endpoints. Sent as the X-TTS-Key header.
# Must match the TTS_WORKER_KEY set in the Convex deployment's env.
TTS_WORKER_KEY=

# Bot token of the TTS Slack app (starts with xoxb-). Needs history-read
# permission in the capture channel. A webhook alone cannot READ messages;
# the bot token is the mechanism.
SLACK_BOT_TOKEN=

# Channel ID (not name) of the #dump capture channel, e.g. C0123ABCDEF.
# Find it in Slack: channel details -> about -> Channel ID.
SLACK_DUMP_CHANNEL_ID=

# GitHub token with repo scope on github.com/Heffnt/ComplexMultiTrigger — the
# code-todo jobs use it to clone/pull/push (as https credentials) and to open
# the executor's PRs (via the gh CLI). Rotating it here takes effect on the
# next cron tick; no other reconfiguration needed. The session-host daemon
# also uses it (when present) for its per-session repo clones.
GH_TOKEN=

# Shared secret for the /sessions/* HTTP endpoints (the session-host daemon,
# worker/session-host/). Sent as the X-Sessions-Key header. Deliberately its
# OWN key, shared with nothing else — one leaked key must not open the other
# surface. Must match SESSIONS_WORKER_KEY in the Convex deployment's env.
# setup.sh only enables the tts-session-host systemd unit once this is
# filled in; rotating it means updating both here and in Convex, then
# `systemctl restart tts-session-host`.
SESSIONS_WORKER_KEY=
