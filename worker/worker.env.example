# The Jarvis Box environment — template for /etc/tts/worker.env
#
# setup.sh copies this file to /etc/tts/worker.env (mode 600) if it does not
# exist yet. Fill in the real values there, NOT here — this template is
# committed to a public repo and must never contain secrets.
#
# Format: KEY=VALUE, one per line. Lines starting with '#' and blank lines are
# ignored. No quoting needed unless the value contains spaces (it shouldn't).

# The Convex *site* origin of the tom.quest deployment. This is the SAME
# subdomain as NEXT_PUBLIC_CONVEX_URL in the web app, but with the .site TLD
# instead of .cloud — HTTP actions (the /tts/* endpoints) are served from
# .convex.site, while the client API is served from .convex.cloud.
# Example: https://exuberant-walrus-123.convex.site
CONVEX_SITE_URL=

# Shared secret for the /tts/* HTTP endpoints. Sent as the X-TTS-Key header.
# Must match the TTS_WORKER_KEY set in the Convex deployment's env.
TTS_WORKER_KEY=

# Bot token of the TTS Slack app (starts with xoxb-). Needs TWO scopes:
#   channels:history — reading #dump (a webhook alone cannot READ messages;
#                      the bot token is the mechanism)
#   chat:write       — posting the ONE threaded reply per #dump message
#                      (Tom's ruling 2026-08-30; the capture itself posts it,
#                      tts.internalCapture → ttsSync.sendSlack)
# NOTHING IN THIS REPO PROVES chat:write IS GRANTED — it has to be confirmed in
# the Slack app's OAuth scopes. Until it is, the reply fails with
# `missing_scope`, which is logged per todo and never blocks preparation.
# Tracked as ledger entry slack-chat-write-scope-unverified.
SLACK_BOT_TOKEN=

# Channel ID (not name) of the #dump capture channel, e.g. C0123ABCDEF.
# Find it in Slack: channel details -> about -> Channel ID.
SLACK_DUMP_CHANNEL_ID=

# GitHub token with repo scope on github.com/Heffnt/ComplexMultiTrigger — the
# planner's brief pass uses it to refresh its read-only CMT clone (as https
# credentials), and the session-host daemon uses it for its per-session repo
# clones, pushes to session/<id> branches and the PRs a session opens (via
# the gh CLI). Rotating it here takes effect on the next cron tick and the
# next session; no other reconfiguration needed.
GH_TOKEN=

# ── Gmail ingestion (poll-gmail.mjs; optional — the job skips until all
# three are set). Mint once with worker/jobs/gmail-auth.mjs on YOUR machine
# (it writes these exact lines to ~/tts-gmail-credentials.env, mode 0600, and
# prints only the path — never a value); scope is gmail.readonly only.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ── Outlook mail (poll-outlook.mjs; optional — the job skips until all three
# are set, and it has NO cron line at all until the credential exists; the line
# is written and commented out in worker/setup.sh). Tom, 2026-08-25: "outlook
# is where the most important mail comes in".
#
# An Entra ID (Azure AD) app registration in Tom's tenant, with the DELEGATED
# Microsoft Graph permission Mail.Read plus offline_access — read-only by
# construction, so a leaked token cannot send mail as him. The refresh token is
# minted ONCE on Tom's own machine because approving it needs a browser; the
# minting helper lands with the fetch half, and like worker/jobs/gmail-auth.mjs
# it will write these three lines to an owner-only file and print only the
# path, never a value.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REFRESH_TOKEN=

# ── Canvas (poll-canvas.mjs; optional — the job skips until set). ONE job and
# ONE copy of this token own Canvas as of the lifeos update: assignments (due
# dates, auto-done on submission) and announcements are both read here, on one
# 30-minute tick. It is NO LONGER in the Convex env — the Convex-side sync
# action that held the second copy is gone, and only the mutation that writes
# todos stayed. Canvas → Account → Settings → "+ New access token".
# CANVAS_BASE_URL defaults to https://canvas.wpi.edu.
# An expired or revoked token is reported to TTS as a job failure and reaches
# Tom in the morning digest, so a dead credential does not go quiet.
CANVAS_TOKEN=
CANVAS_BASE_URL=

# Shared secret for the /sessions/* HTTP endpoints (the session-host daemon,
# worker/session-host/). Sent as the X-Sessions-Key header. Deliberately its
# OWN key, shared with nothing else — one leaked key must not open the other
# surface. Must match SESSIONS_WORKER_KEY in the Convex deployment's env.
# setup.sh only enables the tts-session-host systemd unit once this is
# filled in; rotating it means updating both here and in Convex, then
# `systemctl restart tts-session-host`.
SESSIONS_WORKER_KEY=

# ── Browser sign-in (tts-browse --login; optional — the flag fails loudly and
# does nothing until both are set).
#
# Every interesting tom.quest page is role-gated, so a session that browses
# anonymously sees a shell with 401s where the data should be — a false
# negative, not a result. These are the credentials of an account a session's
# headless browser signs in as, through the ordinary login widget.
#
# WHICH ACCOUNT: one whose role is `agent` — tom.quest's fourth role, which
# exists for exactly this. It reads /turing and /tts, writes nothing anywhere,
# and sees no other page at all: not /sessions, not /forge, not /jarvis, not
# /canvas. On /turing that means the GET that lists GPUs and jobs, but not the
# POST that allocates or the DELETE that cancels, and not the terminal.
# The one list that says so is convex/agentSurfaces.ts.
#
# NEVER TOM'S OWN ACCOUNT. Everything the account here can do, every session
# can do — a session that was told to look at a page could otherwise cancel a
# running training job. (These held Tom's account as a knowing interim from
# 2026-08-30 until the `agent` role existed.)
#
# HOW TO MAKE ONE: sign up at tom.quest through the ordinary login widget,
# then, from the Convex dashboard as Tom, run
#   users.setRoleByUsername({ username: "<the name>", role: "agent" })
#
# The values must be typed into /etc/tts/worker.env by hand. Telling them to a
# session instead writes the password into a Convex-stored transcript, which
# is also why the session-host deletes both names from a session's shell —
# tts-browse reads them back out of this file itself, at the moment it needs
# them.
TOMQUEST_AGENT_USERNAME=
TOMQUEST_AGENT_PASSWORD=

# ── Turing cluster, READ ONLY (tts-turing; optional — the command fails loudly
# and does nothing until this is set).
#
# WHAT IT OPENS: exactly three endpoints of turing-api, and they are all GETs —
#   GET /gpu-report                 nodes, free GPUs by type, GPU jobs
#   GET /jobs                       this account's SLURM jobs
#   GET /sessions/{name}/output     the last N lines of a tmux session
#
# WHAT IT DELIBERATELY DOES NOT OPEN: everything else, and the reason for the
# whole split is one endpoint in that everything — POST /sessions/{name}/run,
# which types an arbitrary command into a tmux session on the cluster under
# Tom's account. Also closed: POST /allocate, DELETE /jobs/{id}, GET /file and
# GET /dirs (which reach the whole cluster home directory), the /forge/* and
# /boolback-snapshot surfaces, and the terminal WebSocket.
#
# THIS IS NOT TURING_API_KEY. That key — the one in secrets/next.env and
# secrets/convex.env — opens all of the above and must never be written into
# this file. Putting it here was the alternative considered and passed over: it
# would have given every TTS session arbitrary shell on a shared WPI cluster in
# exchange for being able to read a GPU report. The read key is a SEPARATE
# value, minted for this box alone, and the matching TURING_READ_KEY must be in
# turing-api/.env on the cluster login node (see secrets/turing-api.env.example)
# with the service restarted, or every verb but `tts-turing health` is a 401.
#
# This key IS inherited by session shells (session.mjs scrubs only
# SESSIONS_WORKER_KEY and GH_TOKEN) — that is the point of it being narrow.
# Rotating it means changing both sides and restarting both services.
TURING_READ_KEY=

# Run-file ingestion identity and durable object store. RUN_HOST is required;
# local is the safe store fallback until the S3-compatible bucket is ready.
RUN_HOST=
RUN_SWEEP_STATE_DIR=
RUN_SWEEP_CLAUDE_ROOTS=
RUN_SWEEP_CODEX_ROOTS=
RUN_SWEEP_BACKLOG=
RUN_STORE_BACKEND=
RUN_STORE_ENDPOINT=
RUN_STORE_BUCKET=
RUN_STORE_REGION=
RUN_STORE_FORCE_PATH_STYLE=
RUN_STORE_WRITE_KEY_ID=
RUN_STORE_WRITE_SECRET=
RUN_STORE_READ_KEY_ID=
RUN_STORE_READ_SECRET=
RUN_FILES_DELETE_AFTER_UPLOAD=
ROWS_FROM_FILES=
