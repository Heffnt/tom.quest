# Template for secrets/convex.env. Real file is gitignored.
# Run `pnpm secrets:init` to populate from your current Convex prod env.

# Convex Auth signing keys.
JWT_PRIVATE_KEY=
JWKS=

# The public site URL Convex Auth uses for the "site URL" identity claim.
SITE_URL=

# Tom-account promotion gate (used by api.users.setTomByUsername).
TOM_SETUP_SECRET=

# Turing API — used by internal.serverHealth.pollTuring cron action.
# Same values as TURING_API_URL / TURING_API_KEY in next.env.
TURING_API_URL=
TURING_API_KEY=

# GPU worker-pool agent key — auths POST/GET /pool in convex/http.ts.
POOL_AGENT_KEY=

# ── TTS (Delegated Todo System) — spec: WikiTom tts/spec.md ─────────────────
# Slack bot token for the TTS app (posts the daily digest; the Jarvis Box
# also uses it to read #dump). Missing token = the digest silently cannot
# send, which violates the sends-even-when-empty rule — keep this set.
SLACK_BOT_TOKEN=
# The channel #tts had before it was renamed #tts-today. A Slack rename keeps
# the id, so this value IS #tts-today's id, and it stays readable as the
# fallback for SLACK_TTS_TODAY_CHANNEL_ID: a missing variable must not silence
# the morning message, which is the one message Tom's day depends on.
SLACK_TTS_CHANNEL_ID=
# The five outbound rooms, one purpose and one cadence each (slack-design.md
# §1). `tts-slack-setup` on the Jarvis Box creates them, invites Tom, joins the
# bot, and prints these exact NAME=value lines. #dump stays inbound capture.
#   #tts-today      the morning message, 5 a.m.
#   #tts-decisions  a decision the delegate took; silence means it stands
#   #tts-needs-you  one thread per thing only Tom can settle
#   #tts-hourly     one glanceable line an hour, and nothing when nothing moved
#   #tts-broken     one message per distinct failure, deduped by job for the day
SLACK_TTS_TODAY_CHANNEL_ID=
SLACK_TTS_DECISIONS_CHANNEL_ID=
SLACK_TTS_NEEDS_YOU_CHANNEL_ID=
SLACK_DUMP_CHANNEL_ID=
# #tts-hourly receives the hourly update (internal.ttsSync.sendHourlyUpdate) —
# its own room, so the every-hour message never crowds #tts. Unset = the hour
# logs one line and sends nothing. This and TOM_SLACK_USER_ID below are both
# printed by `tts-slack-setup` on the Jarvis Box (worker/bin/tts-slack-setup),
# which creates the channel, invites Tom and joins the bot.
SLACK_TTS_HOURLY_CHANNEL_ID=
SLACK_TTS_BROKEN_CHANNEL_ID=
# Slack app SIGNING SECRET (Slack app → Basic Information → App Credentials).
# The ONLY authentication on POST /slack/events, which is this deployment's one
# public write route: Slack cannot present X-TTS-Key, so every request is
# verified by HMAC-SHA256 over "v0:<timestamp>:<raw body>" against the
# X-Slack-Signature header. Unset = the route answers 503 and captures nothing,
# which is the safe direction (never accept an unverified write).
SLACK_SIGNING_SECRET=
# Tom's Slack member id (Slack profile → "..." → Copy member ID, "U…"). A
# threaded reply on POST /slack/events is acted on ONLY when its user equals
# this and the reply is in one of TTS's own channels (SLACK_DUMP_CHANNEL_ID,
# SLACK_TTS_CHANNEL_ID, SLACK_TTS_HOURLY_CHANNEL_ID — each admits replies only
# while set): it becomes a session's next turn, a fact or "done" or a date
# on a todo, a fact on a digest or hourly update, or a learning objection.
# Unset = threaded replies are ignored (logged once); top-level #dump capture
# is unaffected.
TOM_SLACK_USER_ID=
# Key-auth for the Jarvis Box's /tts/* endpoints (convex/http.ts). Generate:
# 64 random hex chars. The same value goes in the Jarvis Box's /etc/tts/worker.env.
TTS_WORKER_KEY=
# Fine-grained GitHub token, Contents:read-only on ComplexMultiTrigger +
# tom.quest — used by internal.ttsSync.refreshMirror (code-todo mirror).
GITHUB_MIRROR_TOKEN=

# ICS calendar feeds for the TTS calendar mirror (hourly cron,
# internal.ttsCalendarFetch.refreshFeeds). JSON array; each url is a private
# capability URL and is a secret. Sources: Google Calendar → Settings →
# your calendar → "Secret address in iCal format"; Outlook web → Calendar →
# Shared calendars → Publish a calendar → ICS link; Canvas → Calendar →
# "Calendar feed". Example:
# TTS_ICS_FEEDS=[{"name":"google","url":"https://calendar.google.com/calendar/ical/..../basic.ics"}]
#
# A PRIVATE FEED (Tom, 2026-09-09). Add "private": true to an entry and its
# rows stay in the record — scheduling still knows he is busy, every planner
# still reads them — but no message TTS sends him names one, and no prompt that
# lists his calendar for a message to him is given one. The family calendar is
# what this is for; the ruling is that the morning message says nothing at all
# about it, not even "one private commitment". Example, with the family feed
# marked:
# TTS_ICS_FEEDS=[{"name":"google","url":"https://…/basic.ics"},{"name":"family","url":"https://…/basic.ics","private":true}]
# A TTS_ICS_FEEDS that cannot be parsed is treated as "every feed is private":
# a misconfigured variable must not be the reason a private calendar reaches
# Slack.
TTS_ICS_FEEDS=

# NO CANVAS_TOKEN HERE (the lifeos update, phase 6). Canvas is read by ONE job
# with ONE copy of the token: worker/jobs/poll-canvas.mjs on the Jarvis Box,
# from CANVAS_TOKEN in /etc/tts/worker.env. The Convex cron action that held
# the second copy is gone; what stayed in convex/ttsCanvas.ts is the mutation
# that writes todos, which the job reaches through POST /tts/canvas-assignments
# on the key it already has. If CANVAS_TOKEN / CANVAS_BASE_URL are still set on
# the deployment, `pnpm secrets:prune` is what removes them.

# Google Calendar WRITE door (internal.ttsCalendarWrite.internalCreateEvent;
# POST /tts/calendar-event). Minted once by Tom with
# worker/jobs/calendar-auth.mjs — scope calendar.events only, a SEPARATE
# token from the Gmail one on purpose.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
