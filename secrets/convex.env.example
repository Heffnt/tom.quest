# Template for secrets/convex.env. Real file is gitignored.
# Run `pnpm secrets:init` to populate from your current Convex prod env.

# Convex Auth signing keys.
JWT_PRIVATE_KEY=
JWKS=

# The public site URL Convex Auth uses for the "site URL" identity claim.
SITE_URL=

# Tom-account promotion gate (used by api.users.setTomByUsername).
TOM_SETUP_SECRET=

# Turing API — used by internal.serverHealth.pollTuring cron action.
# Same values as TURING_API_URL / TURING_API_KEY in next.env.
TURING_API_URL=
TURING_API_KEY=

# GPU worker-pool agent key — auths POST/GET /pool in convex/http.ts.
POOL_AGENT_KEY=

# ── TTS (Delegated Todo System) — spec: WikiTom tts/spec.md ─────────────────
# Slack bot token for the TTS app (posts the daily digest; the Jarvis Box
# also uses it to read #dump). Missing token = the digest silently cannot
# send, which violates the sends-even-when-empty rule — keep this set.
SLACK_BOT_TOKEN=
# Channel ids (Slack "About" tab): #tts receives the digest, #dump is capture.
SLACK_TTS_CHANNEL_ID=
SLACK_DUMP_CHANNEL_ID=
# Key-auth for the Jarvis Box's /tts/* endpoints (convex/http.ts). Generate:
# 64 random hex chars. The same value goes in the Jarvis Box's /etc/tts/worker.env.
TTS_WORKER_KEY=
# Fine-grained GitHub token, Contents:read-only on ComplexMultiTrigger +
# tom.quest — used by internal.ttsSync.refreshMirror (code-todo mirror).
GITHUB_MIRROR_TOKEN=

# ICS calendar feeds for the TTS calendar mirror (hourly cron,
# internal.ttsCalendarFetch.refreshFeeds). JSON array; each url is a private
# capability URL and is a secret. Sources: Google Calendar → Settings →
# your calendar → "Secret address in iCal format"; Outlook web → Calendar →
# Shared calendars → Publish a calendar → ICS link; Canvas → Calendar →
# "Calendar feed". Example:
# TTS_ICS_FEEDS=[{"name":"google","url":"https://calendar.google.com/calendar/ical/..../basic.ics"}]
TTS_ICS_FEEDS=

# Canvas LMS sync (internal.ttsCanvas.internalRefreshCanvas, every 6h).
# Personal access token: Canvas → Account → Settings → "+ New access token".
CANVAS_TOKEN=
# Defaults to https://canvas.wpi.edu when unset.
CANVAS_BASE_URL=
