# Template for secrets/next.env. Real file is gitignored.
# Run `pnpm secrets:init` to populate from your current Vercel prod env.

# Convex platform — wire Next.js to the Convex deployment.
# The two NEXT_PUBLIC_* values also live in the COMMITTED .env at the repo
# root, which is what a checkout without Vercel credentials builds against.
# They are public by construction (Next inlines them into the browser bundle).
# `pnpm secrets:sync` FAILS if the two files disagree — one of them would be
# stale, and only a human knows which.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOY_KEY=

# Sentry source maps (build-time).
SENTRY_AUTH_TOKEN=

# Turing (named cloudflared tunnel + API key).
TURING_API_URL=
TURING_API_KEY=

# Jarvis socket (and optional shared device identity).
OPENCLAW_GATEWAY_URL=
JARVIS_GATEWAY_PASSWORD=
# JARVIS_DEVICE_ID=
# JARVIS_DEVICE_PUBLIC_KEY=
# JARVIS_DEVICE_PRIVATE_KEY=

# Canvas page LLM credentials (server-side only).
#
# PI_AGENT_AUTH_JSON is one Pi auth.json, keyed by Pi provider id, from a Pi
# login performed FOR THIS DEPLOYMENT — not a copy of ~/.codex/auth.json. Pi
# rotates the refresh token at OpenAI when it expires, which invalidates the
# copy any other tool is holding, so the codex command-line tool must not be
# sharing this login. The code refuses a blob in that tool's file shape.
# {"openai-codex":{"type":"oauth","refresh":"...","access":"...","expires":0}}
# PI_AGENT_AUTH_JSON=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
