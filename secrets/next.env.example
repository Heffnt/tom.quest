# Template for secrets/next.env. Real file is gitignored.
# Run `pnpm secrets:init` to populate from your current Vercel prod env.

# Convex platform — wire Next.js to the Convex deployment.
# NEXT_PUBLIC_CONVEX_URL also lives in the COMMITTED .env at the repo root,
# which is what a checkout without Vercel credentials builds against. It is
# public by construction (Next inlines it into the browser bundle).
# `pnpm secrets:sync` FAILS if the two files disagree — one of them would be
# stale, and only a human knows which.
#
# NEXT_PUBLIC_CONVEX_SITE_URL is deliberately absent: no code reads it. The
# browser talks to Convex over NEXT_PUBLIC_CONVEX_URL (app/lib/auth.tsx,
# app/lib/convex-server.ts, app/api/canvas/agent/route.ts), and the .convex.site
# host is only ever named by CONVEX_SITE_URL, which Convex itself sets inside
# the deployment (convex/auth.config.ts) and which the Jarvis Box sets in its
# own worker env. Nothing on the Vercel side needs a third spelling.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOY_KEY=

# Sentry source maps (build-time).
SENTRY_AUTH_TOKEN=

# Turing (named cloudflared tunnel + API key).
TURING_API_URL=
TURING_API_KEY=

# Jarvis socket (and optional shared device identity).
OPENCLAW_GATEWAY_URL=
JARVIS_GATEWAY_PASSWORD=
# JARVIS_DEVICE_ID=
# JARVIS_DEVICE_PUBLIC_KEY=
# JARVIS_DEVICE_PRIVATE_KEY=

# Canvas page LLM credentials (server-side only).
# CODEX_AUTH_JSON=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
