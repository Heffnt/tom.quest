# Template for secrets/next.env. Real file is gitignored.
# Run `pnpm secrets:init` to populate from your current Vercel prod env.

# Convex platform — wire Next.js to the Convex deployment.
# The two NEXT_PUBLIC_* values also live in the COMMITTED .env at the repo
# root, which is what a checkout without Vercel credentials builds against.
# They are public by construction (Next inlines them into the browser bundle).
# `pnpm secrets:sync` FAILS if the two files disagree — one of them would be
# stale, and only a human knows which.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOY_KEY=

# Sentry source maps (build-time).
SENTRY_AUTH_TOKEN=

# Turing (named cloudflared tunnel + API key).
TURING_API_URL=
TURING_API_KEY=

# Jarvis socket (and optional shared device identity).
OPENCLAW_GATEWAY_URL=
JARVIS_GATEWAY_PASSWORD=
# JARVIS_DEVICE_ID=
# JARVIS_DEVICE_PUBLIC_KEY=
# JARVIS_DEVICE_PRIVATE_KEY=

# Canvas page LLM credentials (server-side only).
# CODEX_AUTH_JSON=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- The E2E_* variables are deliberately NOT in this file -------------------
# The Playwright suite reads eight of them: E2E_USER_USERNAME/PASSWORD,
# E2E_ADMIN_USERNAME/PASSWORD and E2E_TOM_USERNAME/PASSWORD (the three role
# cases of e2e/page-visibility.spec.ts), E2E_AUTH_FLOW (e2e/auth-flow.spec.ts)
# and E2E_CONVEX (the live-sync block of e2e/perfume.spec.ts). They live in
# secrets/e2e.env — template at secrets/e2e.env.example, full table in
# README.md under "End-to-end tests".
#
# Two reasons they are not here. Everything in this file is pushed to Vercel
# production env by `pnpm secrets:sync`, and six of the eight are passwords to
# real production accounts that nothing running on Vercel needs. And this file
# would not work anyway: the specs read process.env of the PLAYWRIGHT process,
# which never sees .env.local — playwright.config.ts loads secrets/e2e.env
# itself to close that gap.
