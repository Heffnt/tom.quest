# Template for secrets/turing-api.env. Real file is gitignored.
# Holds the runtime env for the Turing API (FastAPI service in turing-api/).
#
# THIS IS THE ONLY TEMPLATE FOR THIS PROCESS. Every name any module under
# turing-api/ reads is listed below, including the ones that are commented out
# because their default is already correct. turing-api/spec.md section 14 is the
# census this file is generated from; turing-api/env_census_test.py fails if a
# censused name is missing here.
#
# Unlike next.env / convex.env, this file is not pushed by `pnpm secrets:sync`
# because the Turing cluster is not a managed platform we can talk to over an
# API. Edit values here, then scp the file to the cluster:
#
#   scp secrets/turing-api.env <user>@<turing-host>:~/tom.quest/turing-api/.env
#
# ---------------------------------------------------------------------------
# TWO WAYS A VALUE TAKES EFFECT, and every name below is marked with which.
#
# [.env]   Setting the name in turing-api/.env works. These are read after
#          main.py:30 calls load_dotenv(), or at request time.
#
# [export] Setting the name in turing-api/.env DOES NOT WORK. main.py imports
#          dirs, forge and boolback_snapshot at main.py:24-27, above the
#          load_dotenv() call at main.py:30, and those modules read the name at
#          import time — so the .env value lands in the environment a moment too
#          late and the module keeps its default. To set one of these, export it
#          in the shell that launches the service:
#
#            export TURING_FILE_ROOT=/home/<user>/tom.quest-files
#            cd ~/tom.quest/turing-api && python main.py
#
#          A name marked [export] can still be written here as the record of
#          what the launcher should export; it just has no effect on its own.
#
# [export, job] Same as [export] for the Python process, but the value is read
#          by an sbatch wrapper on the compute node out of the environment the
#          API process passes down (sbatch defaults to --export=ALL). Because
#          submission happens at request time, a .env value HAS reached the
#          environment by then, so for these names .env does work — they are
#          marked separately only because no Python code consumes them.
#
# python-dotenv interpolates only the braced form: `${HOME}/x` expands, while a
# bare `$HOME/x` is kept literally and hands sbatch a cwd naming no directory.
# Write absolute paths.
# ---------------------------------------------------------------------------


# === Credentials ===========================================================

# [.env] Shared API key (main.py:32). Must match TURING_API_KEY in next.env and
# convex.env. Opens the ENTIRE API, write verbs included (POST /allocate,
# DELETE /jobs/{id}, POST /sessions/{name}/run — arbitrary commands in a cluster
# tmux session). It is also the HMAC key the terminal token is verified with
# (ws.py:27), and boolback_cron.sh:13 greps it back out of this file.
TURING_API_KEY=

# [.env] Second, narrower key (main.py:40). Opens ONLY three GETs — /gpu-report,
# /jobs, and /sessions/{name}/output — via turing-api's verify_read_key. Its
# holder can look at the cluster and cannot act on it.
#
# A DIFFERENT VALUE from TURING_API_KEY, generated for this purpose. It lives
# in exactly two files: here (scp'd to turing-api/.env on the login node) and
# /etc/tts/worker.env on the Jarvis Box, where the tts-turing command and every
# TTS session read it. It is NOT in next.env or convex.env — the web app and
# the GPU-pool reconciler use the full key.
#
# Leaving it empty is safe and is the fail-closed state: the three endpoints
# simply stay full-key-only, and tts-turing reports 401 on every verb but
# `health`. The service must be restarted after this changes.
TURING_READ_KEY=


# === Service ===============================================================

# [.env] Port uvicorn binds on 127.0.0.1 (main.py:31). Default 8000. The
# cloudflared tunnel config must name the same port.
# API_PORT=8000

# [export] Root that GET /file and GET /dirs are confined to (dirs.py:10).
# Default is the home directory of the account running the service, so the jail
# is always a concrete directory and an unset name never fails open past $HOME —
# but it also means the jail is inherited from the launcher rather than declared.
# TURING_FILE_ROOT=/home/<user>


# === Artifact tree and CMT checkout ========================================

# [.env] Artifact-tree root, read at request time (forge.py:105,
# boolback_snapshot.py:49). No default — the Forge and boolback endpoints raise
# RuntimeError while it is unset. Forge run dirs live under <root>/forge/;
# snapshot dirs resolve under <root>.
# BOOLEAN_BACKDOOR_OUTPUT=/home/<user>/booleanbackdoors/cmt-output

# [export] The CMT checkout (boolean_backdoor package root) that sbatch jobs are
# submitted from. TWO NAMES POINT AT THE SAME DIRECTORY and have the same
# default, ~/booleanbackdoors/ComplexMultiTrigger: BOOLEAN_BACKDOOR_REPO is read
# by forge.py:51 for the train/serve jobs, BOOLBACK_BUILDER_REPO_DIR by
# boolback_snapshot.py:32 for the snapshot build job. Setting one and not the
# other makes those two submit from different checkouts, which looks like an
# ordinary build in both cases — set both, to the same path, until they are
# collapsed onto one name.
# BOOLEAN_BACKDOOR_REPO=/home/<user>/booleanbackdoors/ComplexMultiTrigger
# BOOLBACK_BUILDER_REPO_DIR=/home/<user>/booleanbackdoors/ComplexMultiTrigger


# === Forge (train / serve on a compute node) ===============================

# [export] Override the bundled sbatch wrappers (forge.py:57-58). Defaults are
# turing-api/forge_scripts/forge_train.sbatch and forge_serve.sbatch.
# FORGE_TRAIN_SBATCH=/abs/path/forge_train.sbatch
# FORGE_SERVE_SBATCH=/abs/path/forge_serve.sbatch

# [export] Port vLLM binds on the compute node, reachable from the login node
# over the cluster LAN (forge.py:63), and the idle window in seconds with no
# /forge/chat heartbeat touch before the serve job scancels itself
# (forge.py:61, passed to the job as IDLE_SECS).
# FORGE_SERVE_PORT=8765
# FORGE_SERVE_IDLE_SECS=600

# [export] Login-node -> compute-node timeouts in seconds: probing a serve job
# (forge.py:65) and forwarding one /forge/chat call (forge.py:66).
# FORGE_PROBE_TIMEOUT=4
# FORGE_CHAT_TIMEOUT=120

# [export] Suffix appended to a bare squeue nodename to make it routable from the
# login node (forge.py:70); squeue %N returns a short name like "gpu-5-43". Set
# to the empty string when squeue already returns routable names.
# FORGE_NODE_DOMAIN=.int.turing.wpi.edu

# [export, job] Conda env the sbatch wrappers activate. The train and serve
# wrappers read BOOLBACK_BUILDER_CONDA_ENV directly (forge_train.sbatch:43,
# forge_serve.sbatch:43); FORGE_SERVE_CONDA_ENV overrides it for the serve job
# only and has no Python reader at all. boolback_snapshot.py:31 also reads
# BOOLBACK_BUILDER_CONDA_ENV into a Python name that nothing in Python uses.
# BOOLBACK_BUILDER_CONDA_ENV=boolback
# FORGE_SERVE_CONDA_ENV=boolback


# === Boolback snapshots ====================================================

# [export] Where built .gz snapshots and per-dir submit markers live
# (boolback_snapshot.py:38). Default ~/.cache/boolback-snapshots.
# BOOLBACK_CACHE_DIR=/home/<user>/.cache/boolback-snapshots

# [export] The sbatch wrapper the snapshot build submits
# (boolback_snapshot.py:42). Default turing-api/boolback_build.sbatch. Note that
# the bundled wrapper hardcodes its output path, BOOLEAN_BACKDOOR_OUTPUT, the
# checkout it puts on PYTHONPATH and `conda activate boolback`, so on the
# snapshot side the two names above change only the submitting cwd.
# BOOLBACK_BUILD_SBATCH=/abs/path/boolback_build.sbatch
