# Template for secrets/turing-api.env — the ONE template for the ONE file
# `turing-api/.env` on the Turing login node, which the FastAPI service in
# turing-api/ loads at startup with python-dotenv (main.py:29).
#
# Every name the service reads is declared below, commented names included.
# The authoritative list — name, reading file and line, default when unset —
# is the census in turing-api/spec.md section 14, and turing-api/env_census_test.py
# fails if this file and that census disagree.
#
# Uncommented = you must supply a value. Commented = optional override, shown
# with the default the code uses when the name is absent.
#
# Unlike next.env / convex.env, this file is not pushed by `pnpm secrets:sync`
# because the Turing cluster is not a managed platform we can talk to over an
# API. Edit values here, then scp the file to the cluster:
#
#   scp secrets/turing-api.env <user>@<turing-host>:~/tom.quest/turing-api/.env
#
# python-dotenv expands the BRACED form only: ${HOME} becomes your home
# directory, a bare $HOME stays four literal characters and produces a path
# that names no directory. Every default below is spelled with braces.


# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------

# Shared API key (main.py:31). Must match TURING_API_KEY in next.env and
# convex.env. Opens the ENTIRE API, write verbs included (POST /allocate,
# DELETE /jobs/{id}, POST /sessions/{name}/run — arbitrary commands in a cluster
# tmux session). It is also the HMAC key the terminal WebSocket token is signed
# and verified with (ws.py:27). The service refuses to start without it.
TURING_API_KEY=

# Second, narrower key (main.py:40). Opens ONLY three GETs — /gpu-report, /jobs,
# and /sessions/{name}/output — via turing-api's verify_read_key. Its holder can
# look at the cluster and cannot act on it.
#
# A DIFFERENT VALUE from TURING_API_KEY, generated for this purpose. It lives
# in exactly two files: here (scp'd to turing-api/.env on the login node) and
# /etc/tts/worker.env on the Jarvis Box, where the tts-turing command and every
# TTS session read it. It is NOT in next.env or convex.env — the web app and
# the GPU-pool reconciler use the full key.
#
# Leaving it empty is safe and is the fail-closed state: the three endpoints
# simply stay full-key-only, and tts-turing reports 401 on every verb but
# `health`. The service must be restarted after this changes.
TURING_READ_KEY=


# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------

# Port uvicorn binds on 127.0.0.1 (main.py:30). The co-located cloudflared
# tunnel and turing-api/boolback_cron.sh must point at the same port.
# API_PORT=8000

# Root that GET /file and GET /dirs are confined to (dirs.py:10). Paths outside
# it are refused, as are secret-bearing names anywhere inside it.
# TURING_FILE_ROOT=${HOME}


# ---------------------------------------------------------------------------
# Artifact tree and the CMT checkout
# ---------------------------------------------------------------------------

# Artifact-tree root, read at call time by forge.py:105 and
# boolback_snapshot.py:49. Forge run dirs live under <root>/forge/<run_id>/ and
# every boolback snapshot dir resolves under <root>. There is NO code default:
# both surfaces raise RuntimeError while this is unset.
BOOLEAN_BACKDOOR_OUTPUT=${HOME}/booleanbackdoors/cmt-output

# The CMT checkout (boolean_backdoor package root) that sbatch jobs are
# submitted from. TWO NAMES READ THE SAME DIRECTORY TODAY:
#
#   BOOLEAN_BACKDOOR_REPO     forge.py:51            Forge train + serve
#   BOOLBACK_BUILDER_REPO_DIR boolback_snapshot.py:32  boolback snapshot build
#
# They have the same default, so leaving both commented keeps them in step.
# If you override, OVERRIDE BOTH TO THE SAME PATH: setting one and not the
# other makes Forge and the snapshot build submit from different checkouts,
# which looks like an ordinary build on both surfaces.
# BOOLEAN_BACKDOOR_REPO=${HOME}/booleanbackdoors/ComplexMultiTrigger
# BOOLBACK_BUILDER_REPO_DIR=${HOME}/booleanbackdoors/ComplexMultiTrigger


# ---------------------------------------------------------------------------
# boolback snapshot build
# ---------------------------------------------------------------------------

# Where built .gz snapshots and the per-directory submit markers live
# (boolback_snapshot.py:38).
# BOOLBACK_CACHE_DIR=${HOME}/.cache/boolback-snapshots

# The sbatch wrapper the snapshot build submits (boolback_snapshot.py:42).
# BOOLBACK_BUILD_SBATCH=${HOME}/tom.quest/turing-api/boolback_build.sbatch

# Conda env name, read from boolback_snapshot.py:31 into a Python name nothing
# in Python uses: sbatch exports the API process's environment to every job, and
# the actual readers are the shell wrappers forge_scripts/forge_train.sbatch:43
# and forge_serve.sbatch:43. turing-api/boolback_build.sbatch hardcodes
# `conda activate boolback` and ignores this name entirely.
# BOOLBACK_BUILDER_CONDA_ENV=boolback


# ---------------------------------------------------------------------------
# Forge (train, serve, chat)
# ---------------------------------------------------------------------------

# Override the bundled sbatch wrappers (forge.py:57-58).
# FORGE_TRAIN_SBATCH=${HOME}/tom.quest/turing-api/forge_scripts/forge_train.sbatch
# FORGE_SERVE_SBATCH=${HOME}/tom.quest/turing-api/forge_scripts/forge_serve.sbatch

# Port vLLM binds on the compute node, reachable from the login node over the
# cluster LAN (forge.py:63).
# FORGE_SERVE_PORT=8765

# Seconds a serve job tolerates with no /forge/chat heartbeat before it scancels
# itself and releases its GPU (forge.py:61).
# FORGE_SERVE_IDLE_SECS=600

# Seconds the login node waits when probing a serve job (forge.py:65) and when
# forwarding a /forge/chat request to it (forge.py:66).
# FORGE_PROBE_TIMEOUT=4
# FORGE_CHAT_TIMEOUT=120

# squeue reports a short nodename such as gpu-5-43; the login node can only route
# to a compute node by its cluster FQDN, so this suffix is appended to a bare
# nodename (forge.py:70). Set to the empty string to disable, when squeue already
# returns routable names.
# FORGE_NODE_DOMAIN=.int.turing.wpi.edu

# Read by no Python at all: forge_serve.sbatch:43 reads it directly from the
# environment sbatch exported, to run the serve job in a different conda env from
# the train job. Falls back to BOOLBACK_BUILDER_CONDA_ENV, then to `boolback`.
# FORGE_SERVE_CONDA_ENV=boolback
