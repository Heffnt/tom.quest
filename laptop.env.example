# This file documents $HOME/.tts/env; copy no values into a repository.
# Required stable run identity: laptop or box.
RUN_HOST=
# Override the local sweep state/cache directory.
RUN_SWEEP_STATE_DIR=
# Semicolon-separated Claude run roots; blank uses CLI defaults.
RUN_SWEEP_CLAUDE_ROOTS=
# Semicolon-separated Codex run roots; blank uses CLI defaults.
RUN_SWEEP_CODEX_ROOTS=
# Set to 1 to ingest run files that predate the first installed sweep.
RUN_SWEEP_BACKLOG=
# Reserved retention flag; keep empty or 0 because run files are never deleted.
RUN_FILES_DELETE_AFTER_UPLOAD=
# Leave empty during shadow comparison; set to 1 only at the explicit cut-over.
ROWS_FROM_FILES=
# Select local or s3 run storage.
RUN_STORE_BACKEND=
# S3-compatible service base URL.
RUN_STORE_ENDPOINT=
# Bucket holding compressed run files.
RUN_STORE_BUCKET=
# Signing region for the object store.
RUN_STORE_REGION=
# Use path-style S3 addresses when set to 1.
RUN_STORE_FORCE_PATH_STYLE=
# Upload-only access-key id.
RUN_STORE_WRITE_KEY_ID=
# Upload-only secret.
RUN_STORE_WRITE_SECRET=
# Read-only access-key id.
RUN_STORE_READ_KEY_ID=
# Read-only secret.
RUN_STORE_READ_SECRET=
# Source bytes the backlog import may read per hour; blank means 1 GiB.
RUN_BACKLOG_BYTES_PER_HOUR=
# Wall-clock budget for one backlog pass; blank means ten minutes.
RUN_BACKLOG_PASS_MS=
# Refuse a source file larger than this; blank means 128 MB.
RUN_BACKLOG_MAX_FILE_BYTES=
# Set to 1 to import into a local store; only the proof scripts need this.
RUN_BACKLOG_ALLOW_LOCAL_STORE=
# The gzipped session archive; blank uses the WikiTom checkout's sessions/.
WIKITOM_SESSIONS_DIR=
# tom.Quest Convex HTTP base URL.
CONVEX_SITE_URL=
# Key for the /runs/* and /sessions/* door.
SESSIONS_WORKER_KEY=
# Key for TTS job status and event doors.
TTS_WORKER_KEY=
